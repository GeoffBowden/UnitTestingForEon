<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		autoReload="true"
		throwExceptions="false"
		internalLogLevel="Trace" internalLogFile="c:\temp\nlog-internal.log">

	<!-- optional, add some variables
	https://github.com/nlog/NLog/wiki/Configuration-file#variables
	-->
		<!-- NLog schema file is intentionally not referenced locally to avoid missing-file warnings in the IDE. -->
		<variable name="myvar" value="myvalue"/>
	<!--
	See https://github.com/nlog/nlog/wiki/Configuration-file
	for information on customizing logging rules and outputs.
	-->
	<targets>
		<!--
		add your targets here
		See https://github.com/nlog/NLog/wiki/Targets for possible targets.
		See https://github.com/nlog/NLog/wiki/Layout-Renderers for the possible layout renderers.
		-->
		<!-- Console output event-property used for static logger is replaced by scopeproperty for injected logger-->
		<target xsi:type="Console"
				name="console"
				layout="${longdate}|${level:uppercase=true}|FileName${scopeproperty:item=FileName}|${scopeproperty:item=FunctionName}|${scopeproperty:item=LineNumber}|${message}${exception:format=tostring}" />
		<!-- Output to Debug Window in c# -->
		<target xsi:type="Trace"
				name="debug"
				layout="${longdate}|${logger}|${level:uppercase=true}|${scopeproperty:item=FileName}|${scopeproperty:item=FunctionName}|${scopeproperty:item=LineNumber}|${message}${exception:format=tostring}" />

		<!-- Rolling file -->
		<target xsi:type="File"
				name="file"
				fileName="c:/logs/app.log"
				archiveEvery="Day"
				maxArchiveFiles="30"
				layout="${longdate}|${level:uppercase=true}|${scopeproperty:item=FileName}|${scopeproperty:item=FunctionName}|${scopeproperty:item=LineNumber}|${message}${exception:format=tostring}" />
		<!--
		Write events to a file with the date in the filename.
		<target xsi:type="File" name="f" fileName="${basedir}/logs/${shortdate}.log"
			layout="${longdate} ${uppercase:${level}} ${message}" />
		-->
		<target xsi:type="Database"
				name="database"
				connectionString="${configsetting:name=ConnectionStrings.LoggingDb}">
		<!--connectionString="${configsetting:name=ConnectionStrings.LoggingDb}"-->

			<commandText>
				INSERT INTO dbo.ErrorLog
				(
				UserName,
				ErrorNumber,
				ErrorProcedure,
				ErrorLine,
				ErrorMessage
				)
				VALUES
				(
				@UserName,
				@ErrorNumber,
				@ErrorProcedure,
				@ErrorLine,
				@ErrorMessage
				)
			</commandText>

			<parameter name="@UserName" layout="User: ${windows-identity}" />
			<parameter name="@ErrorNumber" layout="9999" />
			<parameter name="@ErrorProcedure" layout="${scopeproperty:item=FunctionName}" />
			<parameter name="@ErrorLine" layout="${scopeproperty:item=LineNumber}" />
			<parameter name="@ErrorMessage" layout="Exception: |${message}|${onexception:${newline}|${exception:format=tostring}}" />

		</target>
	</targets>
	<rules>
		<!-- add your logging rules here -->
		<!-- Microsoft noise reduced -->
		<logger name="Microsoft.*" maxlevel="Info" final="true" />
		<!-- only log from the database layer to debug and error, information for logic only -->
		<logger name="UnitTestingForEon.Database.*" minlevel="Trace" maxlevel="Information" writeTo="debug" final="false" />
		<logger name="UnitTestingForEon.Database.*" minlevel="Error" writeTo="debug,database" final="true" />
		<!-- Application logging -->
		<logger name="*" minlevel="Trace" writeTo="debug" />
		<logger name="*" minlevel="Information" writeTo="file" />
		<logger name="*" minlevel="Error" writeTo="database" />
	</rules>

	</nlog>
